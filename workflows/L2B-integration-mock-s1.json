      "parameters": {
        "jsCode": "const R=[];function T(n,c){R.push((c?'PASS':'FAIL')+' | '+n);}\nT(\"theme=caption\", $('Extract Photo and Theme').first().json.theme==='fitness tips');\nT(\"photoUrl取最大\", $('Extract Photo and Theme').first().json.photoUrl==='f2_large');\nT(\"photo已抓取带binary\", $('Get Photo File from Telegram').first().json.photoFetched===true);\nT(\"图片已上传tmpfiles\", $('Build Public Image URL').first().json.data.url==='http://tmpfiles.org/123/photo.jpg');\nT(\"Perplexity prompt含主题\", $('Search Trends with Perplexity').first().json.promptDebug.indexOf('fitness tips')>0);\nT(\"GPT看到趋势\", $('Generate Script with GPT-4').first().json.trendsSeen.indexOf('TREND1')>=0);\nT(\"TTS拿到脚本文本\", $('ElevenLabs Voice Synthesis').first().json.ttsText.indexOf('口播稿')>0);\nT(\"mpga转mp3\", $('Convert .mpga to .mp3').first().binary.audio_mp3.fileName==='voice.mp3');\nT(\"FAL image_url已改写https+dl\", $('FAL.ai Video Generation').first().json.falBody.image_url==='https://tmpfiles.org/dl/123/photo.jpg');\nT(\"FAL audio_url已改写\", $('FAL.ai Video Generation').first().json.falBody.audio_url==='https://tmpfiles.org/dl/456/voice.mp3');\nT(\"FAL 480p硬编码\", $('FAL.ai Video Generation').first().json.falBody.resolution==='480p');\nT(\"台账IDEA\", $('Save to Google Sheets').first().json.sheetRow.IDEA==='fitness tips');\nT(\"台账URL VIDEO\", $('Save to Google Sheets').first().json.sheetRow['URL VIDEO']==='https://fal.media/v10000.mp4');\nT(\"回传视频到TG\", $('Send a video').first().json.sentVideo===true && $('Send a video').first().json.sentFile==='https://fal.media/v10000.mp4');\nT(\"Blotato上传\", $('Upload Video to BLOTATO').first().json.blotatoUrl.indexOf('blotato.media')>0);\nT(\"Tiktok发布\", $('Tiktok').first().json.posted===true);\nT(\"9平台全发布\", ['Tiktok','Linkedin','Facebook','Instagram','Twitter (X)','Youtube','Threads','Bluesky','Pinterest'].every(n=>$(n).first().json.posted===true));\nT(\"状态回写DONE\", $('Update Status to \"DONE\"').first().json.STATUS==='DONE');\nconst fails=R.filter(x=>x.indexOf('FAIL')===0);\nconsole.log('SCENARIO S1 total='+R.length+' fail='+fails.length);\nif(fails.length) throw new Error('FAIL: '+fails.join(' ; '));\nreturn [{json:{scenario:'S1', total:R.length, fails:0}}];"
      },
