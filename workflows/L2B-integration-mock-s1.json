    {
      "parameters": {
        "jsCode": "let text, e1Missing=false;\ntry { text = $json.message.content; } catch(e) { e1Missing = true; text = undefined; }\nif (text === undefined) e1Missing = true;\nreturn [{json:{...$json, ttsText: text, e1Missing}, binary:{audio:{data:'QVVESU8=', fileName:'voice.mpga', mimeType:'audio/x-mpga'}}}];"
      },
