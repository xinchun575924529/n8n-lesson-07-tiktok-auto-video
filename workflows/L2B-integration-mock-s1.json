      "parameters": {
        "jsCode": "const caption = $('Extract Photo and Theme').first().json.message.caption;\nconst promptDebug = \"Find the top 3 current viral trends related to: \" + caption + \". Focus on trending topics, hashtags, and content styles that are performing well on TikTok right now. Be specific and actionable. Limit your response strictly to 3 results only — no more.\";\nreturn [{json:{...$json, promptDebug, choices:[{message:{content:'TREND1 viral dance; TREND2 gymtok; TREND3 quick recipes'}}]}}];"
      },
