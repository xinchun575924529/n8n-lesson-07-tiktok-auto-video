    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const b = item.binary?.audio;\n  if (!b) return item;\n  item.binary.audio_mp3 = {\n    ...b,\n    fileName: (b.fileName || 'audio.mp3').replace(/\\.mpga$/i, '.mp3'),\n    mimeType: 'audio/mpeg'\n  };\n  return item;\n});"
      },
